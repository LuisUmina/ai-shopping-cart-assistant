# Application
APP_NAME=AI Shopping Cart Assistant
ENVIRONMENT=development

# Active LLM provider: "openai" or "opencode" (both OpenAI-compatible).
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# OpenCode (Go plan / Chinese models) — OpenAI-compatible endpoint.
# Fill BASE_URL and MODEL with the values from your OpenCode dashboard.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
OPENCODE_MODEL=

# Scraper
SCRAPER_HEADLESS=true        # set to false to watch the browser during development
SCRAPER_TIMEOUT_MS=30000
